<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 定义日志文件存放目录 -->
    <property name="LOG_HOME" value="logs" />

    <!-- 控制台输出 Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 格式模板：%d{时间} %thread{线程} %-5level{级别} %logger{类名缩写} - %msg%n{换行} -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 滚动文件输出 Appender（每日 + 大小分片） -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前活动日志文件路径 -->
        <file>${LOG_HOME}/app.log</file>

        <!-- 滚动策略：基于时间和大小的混合策略 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 日志文件名格式：%d{yyyy-MM-dd} 按天，%i 是分片索引 -->
            <fileNamePattern>${LOG_HOME}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单个日志文件最大大小 -->
            <maxFileSize>10MB</maxFileSize>
            <!-- 保留最近 30 天的日志文件 -->
            <maxHistory>30</maxHistory>
            <!-- 所有归档日志的总大小上限（可选） -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 根日志级别：INFO，同时关联控制台和文件 Appender -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ROLLING_FILE" />
    </root>

    <!-- 为特定包设置更低的日志级别（便于测试 DEBUG 输出） -->
    <logger name="org.example" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ROLLING_FILE"/>
    </logger>
</configuration>